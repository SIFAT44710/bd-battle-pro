rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Tournament Schedules & Slots
    match /tournaments/{tournamentId} {
      // Public read: Players can view live tournament, matches, and slots
      allow read: if true;
      
      // Full admin write access: Authenticated Firebase user
      allow write: if request.auth != null;
      
      // Allow tenant creation and slot updates
      allow create, update: if true;
    }

    // 2. SaaS Tenants Fleet & Subcollections (Matches, Slots, Settings)
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if true;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 2b. Multi-Tenant WhatsApp Bot Cloud Auth Sessions
    match /bot_sessions/{clientId} {
      allow read: if true;
      allow write: if true;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 2. Mobile Financial Services SMS Logs (bKash/Nagad Hardware Gateway)
    match /sms_logs/{trxId} {
      // Public cannot read SMS logs (Prevents scraping financial customer data)
      allow read: if request.auth != null;
      
      // Gateway writing: Authenticated Admin or SifrPay Gateway with structured transaction schema
      allow write: if request.auth != null 
        || (request.resource.data.keys().hasAll(['trxId', 'amount', 'sender', 'timestamp'])
            && request.resource.data.trxId is string
            && request.resource.data.trxId.size() >= 6);
    }

    // 3. Reset Logs (Internal audit trail for manual or scheduled demo resets)
    match /resetLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    // 4. System & White-Label Brand Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Default Deny for any unmapped collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

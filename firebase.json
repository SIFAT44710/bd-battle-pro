{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/player", "destination": "/player.html" },
      { "source": "/player/**", "destination": "/player.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/**", "destination": "/admin.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/*.apk",
      "**/*.exe",
      "**/*.cmd",
      "**/*.bat",
      "**/node_modules/**",
      "node_modules/**",
      "whatsapp-bot/**",
      "client-template/**",
      "ARENA X ____Saas/**",
      "*.md",
      "package*.json",
      "protect-build.js",
      "render.yaml",
      "Dockerfile",
      "src_backup/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

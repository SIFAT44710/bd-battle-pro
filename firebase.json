{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/player", "destination": "/player/dashboard.html" },
      { "source": "/player/**", "destination": "/player/dashboard.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/**", "destination": "/admin.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "ARENA X ____Saas/**",
      "*.md"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

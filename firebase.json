{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/**", "destination": "/admin.html" }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "ARENA X ____Saas/**",
      "*.md"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
